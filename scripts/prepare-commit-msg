#!/bin/sh
# Fills an empty commit message with one generated by Claude.
# Disable per invocation with CLAUDE_COMMIT_MSG=0.
set -u

MSG_FILE="$1"
MSG_SOURCE="${2:-}"

[ "${CLAUDE_COMMIT_MSG:-1}" = "0" ] && exit 0

case "$MSG_SOURCE" in
  message|merge|squash|commit) exit 0 ;;
esac

git diff --cached --quiet && exit 0

if grep -qv '^[[:space:]]*\(#.*\)\?$' "$MSG_FILE" 2>/dev/null; then
  exit 0
fi

HOOK_DIR=$(dirname "$0")
GENERATOR="$HOOK_DIR/gen-commit-msg.sh"
[ -f "$GENERATOR" ] || exit 0

DIFF_LIMIT=${CLAUDE_DIFF_LIMIT:-60000}
RECENT_COMMITS=${CLAUDE_RECENT_COMMITS:-8}

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
RECENT=$(git log -"$RECENT_COMMITS" --pretty=format:'%s' 2>/dev/null)
STAT=$(git diff --cached --stat)
DIFF=$(git diff --cached | head -c "$DIFF_LIMIT")

PROMPT=$(cat <<EOF
Write a git commit message for the staged changes below.

Rules:
- Conventional Commits: type(scope): Subject
- Subject in English, capitalized, imperative mood, no trailing period, max 72 chars
- Add a body only when the change is not self-evident: blank line, then terse bullets
- No Co-Authored-By trailer, no attribution, no mention of AI
- Output the commit message only, no preamble, no code fences

Branch: $BRANCH

Recent commit subjects for style reference:
$RECENT

Diffstat:
$STAT

Diff:
$DIFF
EOF
)

MESSAGE=$(printf '%s' "$PROMPT" | sh "$GENERATOR") || exit 0
[ -n "$MESSAGE" ] || exit 0

MERGED=$(mktemp -t claude-commit-merged) || exit 0
trap 'rm -f "$MERGED"' EXIT

{
  printf '%s\n\n' "$MESSAGE"
  cat "$MSG_FILE"
} >"$MERGED"

cat "$MERGED" >"$MSG_FILE"
exit 0
